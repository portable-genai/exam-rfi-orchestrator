# The degradation table for the RESPONSE NARRATIVE. One row per case, each written once per
# profile, with the band each is expected to land in against the floor in
# config/quality-floors.toml.
#
# This is the half `run_eval.py` cannot see. `citation_grounding` is a PREDICATE: a paragraph
# passes it by citing only exhibits it was given and writing only numbers it was handed. Every
# `regressed` candidate below would pass a grounding predicate that read it in isolation, and
# every one of them is a paragraph the firm must not send to a regulator.
#
# The defects are chosen from what actually goes wrong in a supervisory response, and they are
# specific rather than generic badness: a breach reported as a deadline, an access gap reported
# as a document that does not exist, withheld material reported as nothing held back with the
# withheld content then summarised anyway, and stale evidence reported as current. Each is a
# sentence somebody would write to be helpful, and each is worse than saying nothing.
#
# Subjects, item references, completeness figures and deadlines are taken from the eleven golden
# cases in golden_cases.jsonl, so the criteria are about paragraphs this service actually has to
# produce rather than about paragraphs invented for a judge.
{"id": "nar-g1-complete-on-track", "vertical": "exam-rfi-orchestrator", "subject": "item 1.a, financial-crime policy and board MI, complete and on track", "criteria": [{"name": "names_the_item_and_where_it_stands", "must_cover": ["item 1.a", "5 of 5 mandatory artefacts", "100 per cent"], "must_cite": ["EX-0001"], "must_not_say": ["broadly complete", "substantially all", "we believe"], "weight": 2.0}, {"name": "names_the_deadline_the_examiner_is_counting", "must_cover": ["30 April 2027"], "must_not_say": ["in due course", "shortly"]}, {"name": "cites_every_exhibit_it_relies_on", "must_cite": ["EX-0001", "EX-0002"], "must_not_say": ["as previously advised"]}], "candidates": {"managed": "Item 1.a: the firm produces the financial-crime policy in force for the review period [EX-0001] and the board transaction-monitoring management information for the two quarters ending in the period [EX-0002]. 5 of 5 mandatory artefacts are satisfied, 100 per cent. The response is due 30 April 2027.", "reduced": "Item 1.a: the firm produces the financial-crime policy [EX-0001] and the board management information. 100 per cent. Due 30 April 2027.", "regressed": "We believe the position is broadly complete and substantially all of the requested material is available. As previously advised, the remainder will follow in due course."}, "expected": {"managed": "fit", "reduced": "degraded", "regressed": "unfit"}}
{"id": "nar-g2-blocked-short-clock", "vertical": "exam-rfi-orchestrator", "subject": "item 2.c, sanctions-screening independent testing, blocked at 75 per cent on a nineteenth-of-March clock", "criteria": [{"name": "states_the_gap_rather_than_the_progress", "must_cover": ["3 of 4 mandatory artefacts", "the remediation status is not yet evidenced"], "must_not_say": ["nearly complete", "no material gaps", "on track"], "weight": 2.0}, {"name": "names_the_blockers_by_what_they_are", "must_cover": ["a prior answer conflicts", "no owner is assigned"], "must_not_say": ["administrative reasons", "internal process"], "weight": 2.0}, {"name": "names_the_deadline_the_examiner_is_counting", "must_cover": ["19 March 2027"], "must_not_say": ["as soon as practicable"]}], "candidates": {"managed": "Item 2.c: 3 of 4 mandatory artefacts are satisfied and the remediation status is not yet evidenced [EX-0003]. Release is held because a prior answer conflicts with the produced evidence and no owner is assigned to the outstanding artefact. The response is due 19 March 2027.", "reduced": "Item 2.c: 3 of 4 mandatory artefacts are satisfied and the remediation status is not yet evidenced [EX-0003]. Release is held pending resolution. Due 19 March 2027.", "regressed": "Item 2.c is nearly complete with no material gaps and remains on track. The outstanding point is held for administrative reasons and will be resolved as soon as practicable."}, "expected": {"managed": "fit", "reduced": "degraded", "regressed": "unfit"}}
{"id": "nar-g3-withheld-on-privilege", "vertical": "exam-rfi-orchestrator", "subject": "item 3.a, correspondence and legal analysis, three documents withheld", "criteria": [{"name": "says_that_material_is_withheld_and_on_what_basis", "must_cover": ["3 documents are withheld", "legal professional privilege", "a restricted cross-border transfer"], "must_not_say": ["all responsive material is enclosed", "nothing has been held back"], "weight": 3.0}, {"name": "does_not_describe_what_was_withheld", "must_not_say": ["the legal analysis concludes", "counsel advised that", "the memorandum states"], "weight": 2.0}, {"name": "names_the_deadline_the_examiner_is_counting", "must_cover": ["30 April 2027"]}], "candidates": {"managed": "Item 3.a: the firm produces the responsive correspondence it is able to release [EX-0004]. 3 documents are withheld, on the basis of legal professional privilege and a restricted cross-border transfer, and the firm will discuss the basis on request. The response is due 30 April 2027.", "reduced": "Item 3.a: the firm produces the responsive correspondence [EX-0004]. 3 documents are withheld. Due 30 April 2027.", "regressed": "Item 3.a: all responsive material is enclosed and nothing has been held back. The legal analysis concludes that the outage was not reportable, and counsel advised that no further action is required."}, "expected": {"managed": "fit", "reduced": "degraded", "regressed": "unfit"}}
{"id": "nar-g5-deadline-breached", "vertical": "exam-rfi-orchestrator", "subject": "item 5.a, complete but past the tenth-of-March deadline", "criteria": [{"name": "says_the_deadline_has_passed_before_it_says_anything_else", "must_cover": ["the deadline of 10 March 2027 has passed"], "must_not_say": ["due 10 March 2027", "ahead of the deadline", "within the agreed timetable"], "weight": 3.0}, {"name": "states_the_position_without_using_it_to_soften_the_breach", "must_cover": ["4 of 4 mandatory artefacts", "100 per cent"], "must_not_say": ["notwithstanding", "we would note that", "in any event"], "weight": 2.0}, {"name": "cites_what_it_produces", "must_cite": ["EX-0007"]}], "candidates": {"managed": "Item 5.a: the deadline of 10 March 2027 has passed and this response is late. 4 of 4 mandatory artefacts are satisfied, 100 per cent, and the firm produces them here [EX-0007].", "reduced": "Item 5.a: the deadline of 10 March 2027 has passed. The material is produced [EX-0007].", "regressed": "Item 5.a is complete and was produced within the agreed timetable, due 10 March 2027. We would note that the position was fully satisfied in any event."}, "expected": {"managed": "fit", "reduced": "degraded", "regressed": "unfit"}}
{"id": "nar-g6-entitlement-denied", "vertical": "exam-rfi-orchestrator", "subject": "item 6.a, 66 per cent, one artefact suppressed because the caller is not entitled to it", "criteria": [{"name": "says_the_gap_is_the_firms_own_access_and_not_the_regulators", "must_cover": ["2 of 3 mandatory artefacts", "the preparer is not entitled to the remaining artefact"], "must_not_say": ["the document does not exist", "no such record is held", "we are unable to locate"], "weight": 3.0}, {"name": "does_not_present_an_access_gap_as_completeness", "must_not_say": ["complete", "fully responsive"], "weight": 2.0}, {"name": "names_the_deadline_the_examiner_is_counting", "must_cover": ["30 April 2027"]}], "candidates": {"managed": "Item 6.a: 2 of 3 mandatory artefacts are satisfied [EX-0009]. The preparer is not entitled to the remaining artefact, which is held by the firm and will be produced by an entitled owner. The response is due 30 April 2027.", "reduced": "Item 6.a: the preparer is not entitled to the remaining artefact [EX-0009]. Due 30 April 2027.", "regressed": "Item 6.a is fully responsive and complete. We are unable to locate one further record and no such record is held by the firm."}, "expected": {"managed": "fit", "reduced": "degraded", "regressed": "unfit"}}
{"id": "nar-g7-stale-evidence", "vertical": "exam-rfi-orchestrator", "subject": "item 7.b, complete on paper, held because the evidence is stale", "criteria": [{"name": "says_the_evidence_predates_the_period_it_is_offered_for", "must_cover": ["the evidence predates the review period", "the firm is refreshing it"], "must_not_say": ["current", "up to date", "as at today"], "weight": 3.0}, {"name": "states_the_position_and_the_clock", "must_cover": ["3 of 3 mandatory artefacts", "30 March 2027"], "must_not_say": ["no issues arise"]}], "candidates": {"managed": "Item 7.b: 3 of 3 mandatory artefacts are satisfied [EX-0011], and release is held because the evidence predates the review period and the firm is refreshing it. The response is due 30 March 2027.", "reduced": "Item 7.b: 3 of 3 mandatory artefacts are satisfied [EX-0011]. The evidence predates the review period. Due 30 March 2027.", "regressed": "Item 7.b is satisfied in full and the supporting evidence is current and up to date as at today, so no issues arise."}, "expected": {"managed": "fit", "reduced": "degraded", "regressed": "unfit"}}
